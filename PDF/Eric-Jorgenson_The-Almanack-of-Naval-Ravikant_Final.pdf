s:fontSize&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;            &lt;tps:case&gt;all&lt;/tps:case&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_italic&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;Italic&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_italic-alt&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;Book Italic&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_link&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_no-break&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_no-language&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_strikethrough&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_subscript&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;hide&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:fontSize&gt;0.1 pt&lt;/tps:fontSize&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;            &lt;tps:color&gt;&#xA;                Paper&#xA;            &lt;/tps:color&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_custom-char-1&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_custom-char-2&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&