            <tps:txml>&lt;?xml version="1.0" encoding="utf-8"?&gt;&#xA;&#xA;&lt;?origin&#xA;&#xA;  File=Eric-Jorgenson_The-Almanack-of-Naval-Ravikant.indd&#xA;  Date=Monday, August 10, 2020, 1:02 PM&#xA;&#xA;  From="Typefi Designer√¢¬Ñ¬¢"&#xA;&#xA;?&gt;&#xA;&#xA;&lt;tps:template xmlns:tps="http://www.typefi.com/TemplateXML" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="4.4" xsi:schemaLocation="http://www.typefi.com/TemplateXML http://www.typefi.com/TPS/template/4_4/TemplateXML.xsd"&gt;&#xA;    &#xA;    &#xA;    &lt;!-- =================== --&gt;&#xA;    &lt;!-- Document Definition --&gt;&#xA;    &lt;!-- =================== --&gt;&#xA;    &#xA;    &lt;tps:definition tag="documentDef"&gt;&#xA;        &lt;tps:documentDef&gt;&#xA;            &lt;tps:facingPages&gt;true&lt;/tps:facingPages&gt;&#xA;        &lt;/tps:documentDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &#xA;    &#xA;    &lt;!-- =========================== --&gt;&#xA;    &lt;!-- Character Style Definitions --&gt;&#xA;    &lt;!-- =========================== --&gt;&#xA;    &#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;checkbox&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:fontSize&gt;7 pt&lt;/tps:fontSize&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_all-small-caps&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;            &lt;tps:case&gt;small&lt;/tps:case&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_big-quote-mark&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:fontSize&gt;48 pt&lt;/tps:fontSize&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;SemiBold&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-alt&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;Bold&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-italic&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;SemiBold Italic&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-italic-alt&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/