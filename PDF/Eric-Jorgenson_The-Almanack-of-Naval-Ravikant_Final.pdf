e-mark&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:fontSize&gt;48 pt&lt;/tps:fontSize&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;SemiBold&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-alt&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;Bold&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-italic&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;&#xA;            &lt;tps:font&gt;&#xA;                &lt;tps:name/&gt;&#xA;                &lt;tps:style&gt;SemiBold Italic&lt;/tps:style&gt;&#xA;            &lt;/tps:font&gt;&#xA;            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;&#xA;        &lt;/tps:charStyleDef&gt;&#xA;    &lt;/tps:definition&gt;&#xA;    &lt;tps:definition tag="charStyleDef"&gt;&#xA;        &lt;tps:charStyleDef&gt;&#xA;            &lt;tps:name&gt;scribe_bold-italic-alt&lt;/tps:name&gt;&#xA;            &lt;tps:basedOn&gt;*&lt;/